# NODE SENTINEL Environment Configuration
# Copy this file to .env and configure secret keys before production deployment

# Application Settings
PROJECT_NAME="NODE SENTINEL"
APP_ENV="development"
DEMO_MODE="true"
# Set both values to false/true respectively for a real deployment.  Production
# also requires a persistent USERS_FILE outside the repository.
REQUIRE_AUTH="false"

# Security & Authentication
# Generate a secure 256-bit random key in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_long_random_secret_before_enabling_REQUIRE_AUTH
AUTH_TOKEN_EXPIRE_MINUTES=480

# File Paths (Defaults to sample_data directory)
# Required when REQUIRE_AUTH=true; use a persistent location outside this repository.
# USERS_FILE=/secure/application-data/nodesentinel/users.json
# AUDIT_FILE=/secure/application-data/nodesentinel/audit-log.json

# CORS Configuration
CORS_ORIGINS=*

# Cloud Keep-Alive (Prevents Render free tier from sleeping after 15 minutes of inactivity)
# Render automatically injects RENDER_EXTERNAL_URL. If on another host, set your public URL here:
# KEEP_ALIVE_URL=https://your-node-sentinel.onrender.com
KEEP_ALIVE_INTERVAL_SECONDS=600
